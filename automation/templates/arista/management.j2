{% if management and management.enabled -%}
{% if management.management_interface -%}
interface {{ management.management_interface }}
{% if management.default_gateway -%}
   ip default-gateway {{ management.default_gateway }}
{% endif -%}
!
{% endif -%}
{% if management.ssh_enabled -%}
management ssh
   no shutdown
!
{% endif -%}
{% endif -%}