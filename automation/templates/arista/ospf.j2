{% if ospf and ospf.enabled %}
   router ospf {{ ospf.process_id }}
{% if ospf.router_id %}
   router-id {{ ospf.router_id }}
{% endif %}
{% for network in ospf.networks %}
{% set parts = network.split() %}
{% set area = parts[2] if parts | length > 2 else '0' %}
   network {{ parts[0] }} area {{ '0.0.0.0' if area == '0' else area }}
{% endfor %}
!
{% endif %}