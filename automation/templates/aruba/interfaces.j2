{% for intf in interfaces %}
{% if intf.name != 'mgmt' %}
interface {{ intf.name }}
{% if intf.description %}
description {{ intf.description }}
{% endif %}
{% if intf.ip_addresses %}
routing
{% endif %}
{% for ip in intf.ip_addresses %}
{{ 'ipv6' if ':' in ip else 'ip' }} address {{ ip }}
{% endfor %}
{% if intf.enabled %}
no shutdown
{% else %}
shutdown
{% endif %}
{% endif %}
{% endfor %}